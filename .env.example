# WAP Reconciliation Framework — Environment Variable Template
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is in .gitignore — NEVER commit real credentials.
# In production, inject these via your secrets manager
# (AWS Secrets Manager, GCP Secret Manager, HashiCorp Vault, etc.)

# ── Postgres ───────────────────────────────────────────────────────────────
# Option A: Full DSN (takes precedence over individual vars below)
# DATABASE_URL=postgresql://wap_user:your_password_here@localhost:5432/wap_db

# Option B: Individual vars (used if DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wap_db
POSTGRES_USER=wap_user
POSTGRES_PASSWORD=root

# ── Connection Pool ────────────────────────────────────────────────────────
# Tune based on your workload and Postgres max_connections setting.
# Rule of thumb: WAP_POOL_MAX_CONN * num_workers <= pg max_connections * 0.8
WAP_POOL_MIN_CONN=2
WAP_POOL_MAX_CONN=10